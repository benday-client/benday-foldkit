{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    // the differential test imports the pinned SDK, whose declarations do not
    // satisfy exactOptionalPropertyTypes; the build config still checks every
    // emitted declaration without skipLibCheck
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
