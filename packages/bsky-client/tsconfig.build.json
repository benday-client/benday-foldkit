{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // the pinned atproto SDK declarations do not satisfy
    // exactOptionalPropertyTypes. Project sources keep every strict flag;
    // emitted declarations are checked by the package consumer proof.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
